# Konfigurasi Bot WhatsApp Keuangan & Presensi
# Masukkan nomor HP owner dengan format kode negara (tanpa + atau 0 di depan)
# Contoh: 085712867153 menjadi 6285712867153
OWNER_NUMBER=6285712867153

# Kredensial Presensi Pribadi (v5) - Portal Alma Ata (Nilai hash MD5)
F1_VALUE=b885265e117b013af19ba0d41a93e724
F2_VALUE=b885265e117b013af19ba0d41a93e724
ID_MHS=10577

# Kunci API Google Gemini (Dapatkan gratis di Google AI Studio)
GEMINI_API_KEY=AIzaSyYourAPIKeyHere...

# Pilihan Model Gemini: gemini-2.5-flash, gemini-1.5-flash, atau gemini-1.5-flash-8b
GEMINI_MODEL=gemini-2.5-flash
